# Backend Environment Variables

# Node Environment (production / development)
NODE_ENV=production

# Port (Render sets this automatically, default: 5000)
PORT=5000

# MongoDB Database Connection String (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Frontend URL for CORS (set to your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# JWT Lifetime Authentication Secret (10-Year Permanent Token Expiry)
JWT_SECRET=letsconnect_super_secret_jwt_key_2026_permanent_lifetime
JWT_EXPIRES_IN=3650d
