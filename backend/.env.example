# Backend Environment Variables

# Node Environment (production / development)
NODE_ENV=production

# Port (Render sets this automatically, default: 5000)
PORT=5000

# MongoDB Database Connection String (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Frontend URL for CORS (set to your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# JWT Lifetime Authentication Secrets (10-Year Permanent Token Expiry)
JWT_SECRET=supersecretkeychatapplication2026
JWT_ACCESS_SECRET=supersecretkeychatapplication2026
JWT_REFRESH_SECRET=superrefreshkeychatapplication2026
JWT_ACCESS_EXPIRES_IN=3650d
JWT_REFRESH_EXPIRES_IN=3650d
JWT_EXPIRES_IN=3650d

